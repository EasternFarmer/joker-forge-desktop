{
  "object_type": "consumable",
  "mod_prefix": "modprefix",
  "definition": {
    "key": "variable_test",
    "name": "Variable Test",
    "description": ["Uses and updates variables when consumed."],
    "set": "Tarot",
    "atlas": "Consumables",
    "pos": { "x": 0, "y": 0 },
    "user_variables": [
      { "name": "amount", "var_type": "number", "initial_value": 4 },
      { "name": "chosen", "var_type": "key", "initial_value": "c_fool" },
      { "name": "label", "var_type": "text", "initial_value": "Ready" },
      { "name": "suitvar", "var_type": "suit", "initial_value": "Hearts" },
      { "name": "rankvar", "var_type": "rank", "initial_value": "K" },
      { "name": "handvar", "var_type": "poker_hand", "initial_value": "Flush" }
    ],
    "rules": [{
      "id": "variable_use",
      "trigger": "consumable_used",
      "condition_groups": [{
        "conditions": [
          { "condition_type": "internal_variable", "params": { "variable_name": "amount", "operator": "greater_than", "value": 0 } },
          { "condition_type": "key_variable", "params": { "variable_name": "chosen", "specific_key": "c_fool" } },
          { "condition_type": "text_variable", "params": { "variable_name": "label", "text": "Ready" } },
          { "condition_type": "suit_variable", "params": { "variable_name": "suitvar", "specific_suit": "Hearts" } },
          { "condition_type": "rank_variable", "params": { "variable_name": "rankvar", "specific_rank": "King" } },
          { "condition_type": "poker_hand_variable", "params": { "variable_name": "handvar", "specific_pokerhand": "Flush" } }
        ]
      }],
      "effects": [
        { "effect_type": "modify_internal_variable", "params": { "variable_name": "amount", "operation": "increment", "value": 2 } },
        { "effect_type": "set_dollars", "params": { "operation": "add", "value": { "value": "amount", "valueType": "user_var" } } }
      ]
    }]
  }
}
